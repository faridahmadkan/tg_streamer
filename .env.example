# ============ Required ============

# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# Bot token from @BotFather
BOT_TOKEN=
# Your bot's username, without @
BOT_USERNAME=
# Display name used in messages
BOT_NAME=Music Bot

# Pyrogram session string for the ASSISTANT account — the user account that
# joins the voice chat and streams. Use a dedicated account (NOT one a human
# listens with: Telegram allows one voice-chat connection per account).
# Generate it with gen_session.py (see README).
SESSION_NAME=

# Comma-separated numeric Telegram user IDs allowed to use bot-owner commands
BOT_ADMINS=

# Comma-separated numeric group/supergroup IDs authorized to use this bot
# Example supergroup IDs are usually negative, such as -1001234567890
ALLOWED_GROUPS=

# Legacy compatibility only; BOT_ADMINS replaces SUDO_USERS
SUDO_USERS=

# ============ Optional ============

# Max track length in minutes
DURATION_LIMIT=240

# Downloads cache cap in MB (replays of the same Telegram file are instant while
# cached). Pruned oldest-first after each stream ends; 0 = delete after playing.
DOWNLOADS_CACHE_LIMIT_MB=4096

# Local media library (browse with /library, play by name with /lplay).
# LIBRARY_HOST_DIR : optional host-folder mapping for compatible self-hosting setups.
#                    On Railway, configure LIBRARY_ROOT to a persistent mounted path if available.
# LIBRARY_ROOT     : the in-container mount path (keep as /library).
# LIBRARY_CATEGORIES: optional comma-separated allowlist of top-level folders to
#                    expose; empty = show every subfolder.
#LIBRARY_HOST_DIR=/path/to/your/videos
#LIBRARY_ROOT=/library
#LIBRARY_CATEGORIES=movies,shows,cartoons

# Shown in the rare "assistant is banned" message; the assistant's @username without @
ASSISTANT_NAME=

# Your @username (without @) — used for the "info" button and the /alive "Master" link.
# Leave empty to hide.
OWNER_NAME=
# Display name for the /alive "Master" line. Leave empty to hide.
ALIVE_NAME=

# Support group / updates channel for the buttons. A public username without @
# (e.g. mygroup) or an invite hash with a leading + (e.g. +AbCdEfGh123).
# Leave empty to hide the buttons.
GROUP_SUPPORT=
UPDATES_CHANNEL=

# Card images (URL or local file path). Defaults to a bundled placeholder.
# ALIVE_IMG  - /alive card
# IMG_1..4   - queue/now-playing cards
#ALIVE_IMG=
#IMG_1=
#IMG_2=
#IMG_3=
#IMG_4=

# Your repo's git URL — shown as the "Source Code" button on /start. Empty to hide.
#UPSTREAM_REPO=

# Command prefixes (space separated)
#COMMAND_PREFIXES=/ ! .

# Optional proxy for reaching Telegram (scheme: socks5/socks4/http).
# Note: a SOCKS proxy carries only the signaling, not the voice UDP — for
# networks where Telegram is fully filtered, use a system-level VPN instead.
#PROXY_SCHEME=socks5
#PROXY_HOST=
#PROXY_PORT=1080
#PROXY_USER=
#PROXY_PASS=

# Hardware-accelerated transcoding: "" = CPU (libx264), "vaapi" = Intel/AMD GPU.
# VAAPI requires a compatible Linux host with /dev/dri and VA drivers; usually unavailable on Railway.
#TRANSCODE_HWACCEL=vaapi

# Internet-radio presets for /radio (replaces the built-in list). Name=URL pairs,
# comma-separated. .pls/.m3u playlists are auto-resolved to the real stream.
#RADIO_STATIONS=Groove Salad=https://somafm.com/groovesalad.pls,FIP=https://icecast.radiofrance.fr/fip-midfi.mp3

# Card image shown while streaming radio (URL or file path). Defaults to IMG_1.
#RADIO_IMG=

# Leave the voice chat after N minutes with no human listeners (0 = never).
#IDLE_LEAVE_MINUTES=10

# SponsorBlock: comma-separated categories yt-dlp should cut from YouTube
# downloads. Empty = off. For music, "sponsor,selfpromo,music_offtopic" skips
# sponsor reads and non-music intros/outros. Adds a little download time.
# Categories: sponsor, selfpromo, interaction, intro, outro, preview, music_offtopic
#SPONSORBLOCK_REMOVE=sponsor,selfpromo,music_offtopic

# yt-dlp cookies — Netscape-format cookies.txt for sites that require login
# (age-gated, members-only, etc.). Export from your browser (e.g. with the
# "cookies.txt" extension). Empty = no cookies.
# Set this to the path of the Netscape-format cookies file on the running host.
#COOKIES_FILE=/cookies/cookies.txt
#COOKIES_HOST_PATH=/path/to/cookies.txt

# yt-dlp proxy — proxy URL for non-YouTube downloads (geo-restricted sites).
# socks5://user:pass@host:1080 or http://host:8080. Empty = direct.
#PROXY_URL=socks5://127.0.0.1:1080

# Custom extractor plugins: a directory of .py resolvers (match() + resolve())
# for sites yt-dlp can't handle; they run before yt-dlp. Set PLUGIN_DIR to the
# directory containing your plugin .py files. See examples/plugin_example.py.
#PLUGIN_DIR=
#ENABLE_PLUGINS=true

# Headless-browser fallback: when yt-dlp can't extract a non-YouTube page (its
# player builds the stream URL in JavaScript), load it in headless Chromium,
# capture the media request and stream that. This requires Playwright plus its
# Chromium browser installed on the host; without Chromium this fallback no-ops.
#INSTALL_BROWSER=false
#ENABLE_BROWSER_FALLBACK=true
#BROWSER_FALLBACK_TIMEOUT=45
